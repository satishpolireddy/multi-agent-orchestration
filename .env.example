# ── LLM Configuration ────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# Model to use (gpt-4o-mini is cheapest; gpt-4o for best results)
MODEL_NAME=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────────────────────
# Path to local SQLite DB used by DatabaseTool
SQLITE_DB_PATH=data/agent_memory.db

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── LangGraph Checkpointing ───────────────────────────────────────────────────
# Options: memory | sqlite | postgres (implement in Days 6-8)
CHECKPOINT_BACKEND=memory
